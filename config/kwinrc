[Compositing]
OpenGLIsUnsafe=false

[Plugins]
blurEnabled=true
fadingpopupsEnabled=false
dialogparentEnabled=true

fadeEnabled=false
scaleEnabled=false

squashEnabled=false
translucencyEnabled=false
magiclampEnabled=false

lingmo_scaleEnabled=true
linglauncherEnabled=true


[Effect-Blur]
BlurStrength=15
NoiseStrength=0

[Windows]
FocusStealingPreventionLevel=0
HideUtilityWindowsForInactive=false
BorderlessMaximizedWindows=false
Placement=Centered

[Effect-FlipSwitch]
TabBox=false
TabBoxAlternative=false

[Effect-CoverSwitch]
TabBox=false
TabBoxAlternative=false

[Effect-SlidingPopups]
SlideInTime=250
SlideOutTime=250

[TabBox]
ActivitiesMode=1
ApplicationsMode=0
BorderActivate=9
BorderAlternativeActivate=9
DesktopMode=1
HighlightWindows=true
LayoutName=ling_thumbnail
MinimizedMode=0
MultiScreenMode=0
ShowDesktopMode=0
ShowTabBox=true
SwitchingMode=0

[ElectricBorders]
TopLeft=None

[TouchEdges]
Bottom=None
Left=None
Right=None
Top=None

# KWin 6.3+ reads the decoration plugin from kdecoration3 but the button layout
# and border size from kdecoration2: keep both. XIA = close, minimize, maximize
# on the left, macOS order.
[org.kde.kdecoration2]
BorderSize=Normal
ButtonsOnLeft=XIA
ButtonsOnRight=

[org.kde.kdecoration3]
BorderSize=Normal
ButtonsOnLeft=XIA
ButtonsOnRight=
library=org.lingmo.decoration
theme=
